# EditEase frontend — environment template
# Copy to "frontend/.env" and fill in your value.

# Google OAuth client ID (exposed to the browser; use the public client ID).
VITE_GOOGLE_CLIENT_ID=

# Base URL of the EditEase API. Leave unset for local development
# (defaults to http://127.0.0.1:5000); set it for any real deployment.
VITE_API_BASE=
