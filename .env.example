# EditEase — environment configuration template
# Copy this file to ".env" and fill in your own values.
# This file contains NO real credentials.

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
DB_NAME=editease
COLLECTION=scenes

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=True
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (SMTP — e.g. Gmail with an App Password)
# ---------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=            # 16-char app password, NOT your account password
MAIL_DEFAULT_SENDER=
MAIL_FROM=               # legacy alias (optional)
RESEND_API_KEY=          # optional / transitional email provider

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Celery / Redis (async job queue)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Cloudinary (media storage)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# External tools
# ---------------------------------------------------------------------------
# Path to the ffmpeg executable. Use "ffmpeg" if it is on your PATH.
FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# Pipeline tuning (defaults shown — override only if needed)
# ---------------------------------------------------------------------------
CLASSIFIER_TYPE=ml              # "ml" | "rule_based"
SCENE_DETECT_THRESHOLD=27.0
MIN_SCENE_DURATION=0.5
CONF_AUTO_HIGH=0.85
CONF_FUSE_LOW=0.58
ML_WEIGHT=0.65

# Audience-reaction detection
AUDIENCE_REACTION_MIN_FACES=

# ML quality-gate thresholds (used by tests/eval)
ML_EVAL_MAX_SAMPLES=
ML_MIN_ACCURACY=
ML_MIN_MACRO_PRECISION=
ML_MIN_MACRO_RECALL=
ML_MAX_P95_SECONDS=
